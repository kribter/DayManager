<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!--
      ============================================================
      主色换成低饱和的钢蓝。

      【为什么不能用模板自带的紫色 #512BD4】
      那是 MAUI 新建项目时的默认色，跟这个软件要解决的问题没有关系。
      这个软件是拿来对抗"打开电脑就逃避"的，界面本身必须是低刺激的：
      高饱和紫色在深色背景上很跳，长时间盯着的疲劳感明显，
      而一个让人想关掉窗口的界面，对"降低启动摩擦力"这个目标是反作用。
      钢蓝偏冷、饱和度低，和"冷静地看一眼今天要做什么"的语气一致。

      【为什么 PrimaryDarkText 是深色而不是浅色】
      深色模式下按钮底色是 PrimaryDark（浅蓝），此时按钮文字必须是深的，
      否则浅底浅字看不见。这一对值必须一起改。
      ============================================================
    -->
    <Color x:Key="Primary">#3F6FB5</Color>
    <Color x:Key="PrimaryDark">#9DB8DE</Color>
    <Color x:Key="PrimaryDarkText">#1B2B3D</Color>
    <Color x:Key="Secondary">#D8E4F2</Color>
    <Color x:Key="SecondaryDarkText">#7FA5D4</Color>
    <Color x:Key="Tertiary">#24507F</Color>

    <!--
      产品的语义色。
      【为什么要有"语义色"这一层，而不是每个控件各写一个颜色值】
      写散了之后要改就得全局搜；更麻烦的是同一件事会有两种绿——
      进度条用 #2E7D5B、打勾用 ForestGreen、别处又用 MediumSeaGreen，
      三个地方深浅不一，界面看着就不像同一个软件做的。
      语义色把"这是什么含义"和"具体是哪个值"分开，改值时只改一处。
    -->
    <Color x:Key="DoneGreen">#2E7D5B</Color>
    <Color x:Key="ProgressOrange">#C07820</Color>
    <Color x:Key="WarnOrange">#CC7000</Color>
    <Color x:Key="MutedText">#8A8A8A</Color>

    <!-- 气泡底色刻意不跟主题走：见 ChatViewModel 里 BubbleColor 的说明。 -->
    <Color x:Key="BubbleSelf">#DCEEFB</Color>
    <Color x:Key="BubbleAi">#F2F2F2</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <!--
      卡片底色。

      【为什么卡片必须有底色】
      之前所有卡片都只画了一圈 1px 的边框、没有底色，和页面完全同色
      （页面是 White / OffBlack）。结果整个界面是一堆描边框平铺，
      层级全靠那根细灰线撑着——看着像没上完的稿子。
      底色只需要比页面深一点点（深色主题里是浅一点点），层次立刻就出来了。

      【为什么是"差一点点"而不是明显更深】
      用明显的灰块会让页面变成一堆色块拼接，视觉噪音反而更大。
      卡片的作用是"把相关内容圈在一起"，不是"强调这里有个框"，
      所以对比度够分辨就行，不必抢戏。

      【为什么带一点蓝】
      主色是钢蓝，卡片底色跟着偏一点点冷，整体才像同一个软件做的；
      用纯中性灰的话，浅色主题下会显得发脏。
    -->
    <Color x:Key="CardBgLight">#F6F8FA</Color>
    <Color x:Key="CardBgDark">#262626</Color>
    <Color x:Key="CardBorderLight">#E4E8EE</Color>
    <Color x:Key="CardBorderDark">#303030</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!--
      ============================================================
      下面这几组是「同一个含义、两套数值」。

      【为什么要成对定义，而不是一个 key 走到底】
      浅色主题里读得清的颜色，搬到深色背景上往往不是"看不清"，就是"太扎眼"：
        - 已完成事项用的灰 #8A8A8A，在黑底上近乎隐形，划掉跟没划一样；
        - 气泡用的浅蓝 #DCEEFB，在黑底上是一块高亮板，长时间盯着累。
      所以每个语义都给两个值，由主题决定用哪个。

      【为什么用 Light/Dark 后缀，而不是靠 AppThemeBinding 自动切换】
      XAML 里可以写 {AppThemeBinding Light=..., Dark=...}，但这条代码路径
      覆盖不到 C# 里算出来的颜色（气泡底色、状态徽章色都是在 ViewModel 里赋的）。
      两套值都摆在这里，XAML 和 C# 读的是同一份定义，不会出现
      "XAML 跟着主题变了、C# 里那几个还是浅色值"这种一半变一半没变的情况。

      【关于深色下的"纯白"】
      正文刻意不用纯白 #FFFFFF，而用 #E8EAED。
      纯白在黑底上会有光晕（文字边缘发虚），长段文字尤其明显；
      降一点亮度后仍然清楚，但看着不刺眼。这是长期盯着的界面，不是海报。
      ============================================================
    -->

    <!-- 正文 / 次要 / 弱化：三档层次 -->
    <Color x:Key="TextPrimaryLight">#212121</Color>
    <Color x:Key="TextPrimaryDark">#E8EAED</Color>
    <Color x:Key="TextMutedLight">#8A8A8A</Color>
    <Color x:Key="TextMutedDark">#A2A2A2</Color>
    <Color x:Key="TextFaintLight">#B0B4B8</Color>
    <Color x:Key="TextFaintDark">#6E7276</Color>

    <!-- 气泡上的字：底色是自己给的，文字色必须跟底色配，不能跟正文走 -->
    <Color x:Key="TextOnBubbleLight">#1A1A1A</Color>
    <Color x:Key="TextOnBubbleDark">#F2F4F6</Color>

    <!-- 状态色：深底上要提亮，否则"完成"的绿会暗成一团 -->
    <Color x:Key="DoneGreenDark">#4CAF7D</Color>
    <Color x:Key="ProgressOrangeDark">#E5A63C</Color>
    <Color x:Key="WarnOrangeDark">#E08A20</Color>
    <Color x:Key="DangerLight">#C0392B</Color>
    <Color x:Key="DangerDark">#E0685C</Color>

    <!-- 气泡底色：深色下换成同等"比页面亮一点"的深色，而不是把浅色照搬 -->
    <Color x:Key="BubbleSelfDark">#2C465E</Color>
    <Color x:Key="BubbleAiDark">#2B2B2B</Color>

    <!-- 页面底色。多数页面不需要显式设（平台会给），
         但要画分隔线、遮罩、或者某个控件自己带底的时候用得上。 -->
    <Color x:Key="PageBgLight">#FFFFFF</Color>
    <Color x:Key="PageBgDark">#1A1A1A</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>