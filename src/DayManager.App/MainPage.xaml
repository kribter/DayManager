<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DayManager.App.ViewModels"
             x:Class="DayManager.App.MainPage"
             x:DataType="vm:MainViewModel"
             Title="DayManager">

    <!--
      ============================================================
      XAML 是什么：它就是一份"界面结构说明书"，本质是一棵对象树。
      <Button .../> 这一行等价于后台代码里 new Button { Text = "..." }。
      编译器会把它变成真正的代码（SourceGen 模式），所以写错属性名时
      编译期就能报错，而不是运行时才崩。

      {Binding xxx} 的含义是"去 BindingContext 里找 xxx 这个属性"。
      BindingContext 在 MainPage.xaml.cs 里被赋成 MainViewModel，
      于是这里写的 {Binding SummaryText} 就是 ViewModel 里那个字段。
      这就是 MVVM 的关键：XAML 只声明"显示哪个数据"，不关心数据从哪来。

      x:DataType 是为了开启"编译期绑定检查"。加上之后，
      如果拼错属性名（比如写成 SummaryTxt），编译会直接报错，
      而不是等到运行时才发现界面一片空白。强烈建议永远写上。
      ============================================================

      整个页面用一个 Grid 划成六行：
        第 0 行 Auto  标题和日期      —— 高度随内容
        第 1 行 Auto  今日完成统计    —— 高度随内容
        第 2 行 Auto  「正在做」/「到点了」—— 平时折起来，不占空间
        第 3 行 *     清单列表        —— 吃掉剩下的所有空间
        第 4 行 Auto  快速添加区      —— 固定在底部
        第 5 行 Auto  时间选择器      —— 只有勾了「定时」才出来
      "*" 表示"把剩余高度全给我"，所以列表会自动撑满中间。
    -->
    <!--
      空着的时候不说"没有任务"，而说"加一条，哪怕只是先看两分钟"——
      这一句是给正在逃避的人留的最低门槛。
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto"
          Padding="18"
          RowSpacing="12">

        <!-- ================= 第 0 行：可以翻的日期 =================

             【为什么左上角不再是固定的"今天"两个字】
             只能看今天的话，提前排到后天的事在那之前是"隐形"的：
             写进去了，但没有任何地方能确认它在不在。
             所以要能翻——往前往后，或者直接从日历里挑一天。

             【为什么中间放 DatePicker 而不是一个 Label + 按钮】
             DatePicker 本身就是"显示日期 + 点开挑日期"两件事合一的控件，
             用它等于一个控件给全了两种用法，不用再发明一个展开/收起的开关。
             旁边那三个小字（今天/明天/3 天后）是给人看的换算结果，
             省掉"还得自己数一下差几天"这一步。

             【为什么翻页按钮上写的是最普通的 &lt; 和 &gt;，而不是 ‹ › 那种更漂亮的符号】
             上一版写的是 ‹ ›（U+2039/U+203A），结果两个按钮都是空的——
             系统字体里没有这两个字形，MAUI 又不会像浏览器那样自动找替代字体，
             于是静默地什么都不显示。箭头类符号、数学符号、制表符都可能有这个下场。
             结论：界面上的符号只用"每个字体都一定有"的那些
             （ASCII 的 &lt; &gt;、以及 ✓ 这类已经验证过能显示的）。
             漂亮的符号留到确定字体的那天再用。 -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,Auto,Auto,Auto,*,Auto"
              ColumnSpacing="4">
            <Button Grid.Column="0"
                    Text="&lt;"
                    Style="{StaticResource RoundIconButton}"
                    FontAttributes="Bold"
                    Command="{Binding PreviousDayCommand}" />
            <DatePicker Grid.Column="1"
                        Date="{Binding SelectedDate}"
                        MinimumDate="{Binding EarliestDate}"
                        Format="M月d日 dddd"
                        FontSize="17"
                        FontAttributes="Bold"
                        WidthRequest="200"
                        VerticalOptions="Center" />
            <Label Grid.Column="2"
                   Text="{Binding RelativeDayText}"
                   Style="{StaticResource Caption}"
                   FontSize="12"
                   VerticalOptions="Center"
                   Padding="4,0,0,0" />
            <Button Grid.Column="3"
                    Text="&gt;"
                    Style="{StaticResource RoundIconButton}"
                    FontAttributes="Bold"
                    Command="{Binding NextDayCommand}" />

            <!-- 只有翻走了才出现，今天它在页面上没有意义 -->
            <Button Grid.Column="5"
                    Text="回到今天"
                    Style="{StaticResource ChipButton}"
                    Command="{Binding GoTodayCommand}"
                    IsVisible="{Binding IsNotViewingToday}"
                    HorizontalOptions="End" />
        </Grid>

        <!-- ================= 第 1 行：完成统计 =================
             这里也体现了产品原则：先给正反馈。
             显示的是"已完成几件"，而不是"还剩几件"。 -->
        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <Label Text="{Binding SummaryText}"
                   FontSize="14"
                   FontAttributes="Bold" />
            <ProgressBar Progress="{Binding CompletionRatio}"
                         HeightRequest="6"
                         ProgressColor="{StaticResource DoneGreen}" />
        </VerticalStackLayout>

        <!-- ================= 第 2 行：正在做 / 到点了 =================
             平时这一行等于不存在（两块都折起来），一点空间都不占；
             只有计时中、或者 10 分钟到点等着收尾时才出现。

             【为什么到点了要在界面上问一句，而不是只发一条通知】
             通知会滑走，而这一句正反馈恰恰要落在看得见的地方：
             做完的要有个收尾，没做完的要知道这 10 分钟算数。
             界面上留一块，用户什么时候回来都还在。 -->
        <Border Grid.Row="2"
                IsVisible="{Binding FocusRunning}"
                Padding="10,8"
                Stroke="{StaticResource ProgressOrange}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0"
                       Text="{Binding FocusRunningText}"
                       FontSize="13"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="停"
                        Style="{StaticResource ChipButton}"
                        WidthRequest="46"
                        Command="{Binding EndFocusCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                IsVisible="{Binding FocusFinished}"
                Padding="10,8"
                Stroke="{StaticResource DoneGreen}"
                StrokeThickness="1">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding FocusPromptText}"
                       FontSize="13" />
                <HorizontalStackLayout Spacing="8">
                    <Button Text="再来 10 分钟"
                            Style="{StaticResource ChipButton}"
                            Command="{Binding ContinueFocusCommand}" />
                    <Button Text="今天先到这"
                            Style="{StaticResource ChipButton}"
                            Command="{Binding EndFocusCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- ================= 第 3 行：今日清单 =================
             CollectionView 是列表控件的现代版本。
             相比老的 ListView，它支持横向/纵向、网格布局，而且性能更好。
             ItemsSource 绑到 ObservableCollection，集合内容一变界面自动重画。 -->
        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding TodayItems}"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <!-- EmptyView：列表为空时显示的内容。
                     文案刻意写成鼓励而非催促，避免一打开就有压力。
                     在别的日子里它会换成"可以提前放进来"的说法（见 EmptyHint）。 -->
                <Label Text="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=EmptyHint}"
                       Style="{StaticResource Caption}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       Margin="0,40,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <!-- DataTemplate 描述"每一行长什么样"。
                     它的 BindingContext 是集合里的单个元素，也就是一个 ItemViewModel，
                     所以下面的 {Binding Title} 取的是某一行的标题。 -->
                <DataTemplate x:DataType="vm:ItemViewModel">
                    <!--
                      行高：Padding 从 "2,6" → "4,8" → 现在 "6,10"。
                      一开始一行连内容带间距只有 40 出头，七八条就挤成一团，
                      扫视时相邻两条的说明文字容易看成同一条的。
                      这个软件的清单是要"扫一眼就知道还剩什么"的，行距是功能不是装饰。
                    -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                          ColumnSpacing="10"
                          Padding="6,10">
                        <!-- 左边的打勾按钮。
                             Command 需要绑到"页面级"的命令（ToggleCompleteCommand
                             属于 MainViewModel，不属于每一行的 ItemViewModel），
                             所以用 RelativeSource AncestorType 往外找，
                             意思是"沿着界面树往上找第一个类型是 MainViewModel 的父级"。
                             CommandParameter="{Binding .}" 里的 "." 表示"当前这一行的对象"，
                             这样命令才知道用户点的是哪一条。 -->
                        <Button Grid.Column="0"
                                Text="&#10003;"
                                Style="{StaticResource RoundIconButton}"
                                TextColor="{Binding CheckColor}"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ToggleCompleteCommand}"
                                CommandParameter="{Binding .}" />

                        <!-- 中间：标题 + 状态徽章 + 一行说明（时间/逾期/已进行时长） -->
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2"
                                             VerticalOptions="Center">

                            <!--
                              标题和状态徽章并排。
                              【为什么徽章要单独占一个位置，而不是并进下面那行说明】
                              下面那行是"什么时候做"（时间/估时/逾期），
                              徽章是"这件事现在是什么状态"——两类信息混在一行里会读成一句，
                              比如"进行中 · 已进行 25 分钟"，扫视时容易看漏前半。
                              跟标题同行则不同：它紧挨着"是什么事"，
                              正是人判断"这条我要不要管"时先看的地方。
                            -->
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding Title}"
                                       TextColor="{Binding TitleColor}"
                                       TextDecorations="{Binding TitleDecorations}"
                                       FontSize="15"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />

                                <Border Padding="5,1"
                                        Stroke="{Binding StatusBrush}"
                                        StrokeThickness="1"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding HasStatusBadge}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding StatusText}"
                                           TextColor="{Binding StatusColor}"
                                           FontSize="10" />
                                </Border>
                            </HorizontalStackLayout>

                            <!-- 最小启动步骤：只在还没了结时出现（见 ItemViewModel.StepText） -->
                            <Label Text="{Binding StepText}"
                                   Style="{StaticResource Caption}"
                                   TextColor="{StaticResource MutedText}"
                                   IsVisible="{Binding HasMinimalStep}" />

                            <Label Text="{Binding Subtitle}"
                                   Style="{StaticResource Caption}" />
                        </VerticalStackLayout>

                        <!-- 右边：更多操作（重命名 / 删除 / 改状态在里面的菜单里）

                             【为什么这里写"更多"两个字，而不是 ⋯ / ⋮ 这种图标】
                             上一版是一个 ⋮ 号的图标按钮，结果有两个问题：
                               1. 同样是字形问题——有些系统字体里它就是三个点，
                                  小到看不清，甚至干脆是空的，看着像"这里什么都没有"；
                               2. 更关键的：就算图标显示出来了，它也没说自己是"能点的菜单"，
                                  于是用户根本不知道删除藏在里面。
                             写成"更多"两个字，不依赖任何字形，而且字面上就说明
                             "点开还有东西"。两个字的宽度换掉了"找不到删除在哪"这个问题，划算。 -->
                        <!--
                          「先做 10 分钟」

                          【为什么直接放在条目上，而不是收进「更多」菜单】
                          这个按钮的全部价值就是"少一步"。
                          让人先想起来去菜单里找它，等于把承诺又抬高了一点——
                          而它存在的唯一理由是降低承诺。
                          已完成 / 已放弃的条目不显示（CanFocus）：
                          那是已经了结的事，再给一个"开始"是自相矛盾。
                        -->
                        <Button Grid.Column="2"
                                Text="10 分钟"
                                Style="{StaticResource ChipButton}"
                                WidthRequest="60"
                                IsVisible="{Binding CanFocus}"
                                ToolTipProperties.Text="先做 10 分钟，只做 10 分钟"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=StartFocusCommand}"
                                CommandParameter="{Binding .}" />

                        <Button Grid.Column="3"
                                Text="更多"
                                Style="{StaticResource ChipButton}"
                                WidthRequest="46"
                                ToolTipProperties.Text="重命名 / 删除 / 改状态"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainViewModel}}, Path=ShowActionsCommand}"
                                CommandParameter="{Binding .}" />

                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ================= 第 4 行：快速添加 =================
             输入框和按钮并排，省掉一整行的高度。

             【为什么时间选项缩成一个方框，点开才出现时间选择器】
             上一版是「输入框 / 勾选框+时间选择器 / 按钮」三行，
             底部占掉三分之一屏，清单反而被挤得很短。
             而"指定开始时间"是个低频操作——大多数随手加的待办不需要几点几分。
             所以把它收进一个勾选框，勾了才展开时间选择器。 -->
        <Grid Grid.Row="4"
              ColumnDefinitions="Auto,Auto,*,Auto"
              ColumnSpacing="4">
            <CheckBox Grid.Column="0"
                      IsChecked="{Binding UseSpecificTime}"
                      MinimumWidthRequest="0"
                      Scale="0.8"
                      VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="定时"
                   Style="{StaticResource Caption}"
                   FontSize="10"
                   VerticalOptions="Center" />
            <Entry Grid.Column="2"
                   Text="{Binding NewTitle}"
                   Placeholder="{Binding AddPlaceholder}"
                   ReturnType="Done"
                   ReturnCommand="{Binding AddItemCommand}"
                   FontSize="14" />
            <Button Grid.Column="3"
                    Text="加入"
                    Command="{Binding AddItemCommand}"
                    WidthRequest="60"
                    HeightRequest="40"
                    CornerRadius="8"
                    Padding="0"
                    FontSize="13" />
        </Grid>

        <!-- 只有勾了上面的框才会出现，不占平时的空间 -->
        <TimePicker Grid.Row="5"
                    Time="{Binding NewTime}"
                    IsVisible="{Binding UseSpecificTime}"
                    IsEnabled="{Binding UseSpecificTime}"
                    Format="HH:mm"
                    FontSize="13"
                    HorizontalOptions="Start" />

    </Grid>

</ContentPage>
