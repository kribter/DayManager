<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DayManager.App.ViewModels"
             x:Class="DayManager.App.TimePage"
             x:DataType="vm:TimeViewModel"
             Shell.NavBarIsVisible="False"
             Title="时间">

    <!--
      ============================================================
      时间页（第四个 Tab，也是四个界面里的最后一块）。

      【这一页要回答的问题】
      "我的时间到底去哪了" —— 以及顺带回答"我几点最在状态"。
      后者不是一个统计问题：排程、干预时机、AI 建议的时间点都靠它。

      【为什么日/周/月/年做成四个并排的小按钮，而不是下拉框或左右滑】
      下拉框要先点开才知道有哪几个选项，而"我能不能看这一年"是个要先看见才想得起问的问题；
      左右滑没有任何视觉提示，等于藏起来了一个功能。
      四个按钮摆在那里，用户一眼就知道这一页能看到多远。

      【为什么娱乐时长默认收起来】
      回顾界面的第一原则是正反馈优先（需求 2.9）。
      一进来就把"你今天刷了两小时"摆在最显眼的地方，
      结果是人不敢打开这一页 —— 而不看的统计等于没做。
      收起不是隐藏：按钮就在摘要卡片里，想看的人一次点击就到。
      ============================================================
    -->

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="18,14,18,0"
          RowSpacing="12">

        <!-- ================= 第 0 行：四个跨度 =================
             注意符号只用 ASCII 的 < 和 >。
             上一版在日程页用过 ‹ ›（U+2039/U+203A），系统字体里没有这两个字形，
             按钮直接显示成空白，且不报错。 -->
        <HorizontalStackLayout Grid.Row="0" Spacing="8">
            <Button Text="日"
                    Style="{StaticResource ChipButton}"
                    WidthRequest="56"
                    Command="{Binding SetSpanCommand}"
                    CommandParameter="Day">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsDay}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="周"
                    Style="{StaticResource ChipButton}"
                    WidthRequest="56"
                    Command="{Binding SetSpanCommand}"
                    CommandParameter="Week">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsWeek}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="月"
                    Style="{StaticResource ChipButton}"
                    WidthRequest="56"
                    Command="{Binding SetSpanCommand}"
                    CommandParameter="Month">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsMonth}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button Text="年"
                    Style="{StaticResource ChipButton}"
                    WidthRequest="56"
                    Command="{Binding SetSpanCommand}"
                    CommandParameter="Year">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsYear}" Value="True">
                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </HorizontalStackLayout>

        <!-- ================= 第 1 行：翻日期 ================= -->
        <Grid Grid.Row="1"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8">
            <Button Grid.Column="0"
                    Text="&lt;"
                    Style="{StaticResource ChipButton}"
                    WidthRequest="36"
                    Command="{Binding PrevCommand}" />

            <!-- 标题随跨度变：10月27日 周二 / 10月26日 – 11月1日 / 2026年10月 / 2026年。
                 切换跨度不改"看的是哪一天"，所以从 27 号切到「周」落在本周，而不是跳回今天。 -->
            <Label Grid.Column="1"
                   Text="{Binding RangeTitle}"
                   FontSize="15"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />

            <!-- 未来的时间是 0，翻过去只有一片空白和"你什么都没做"的错觉，
                 所以能翻到未来时按钮直接不可用，而不是翻过去再显示空。 -->
            <Button Grid.Column="2"
                    Text="&gt;"
                    Style="{StaticResource ChipButton}"
                    WidthRequest="36"
                    IsEnabled="{Binding CanGoNext}"
                    Command="{Binding NextCommand}" />
        </Grid>

        <!-- ================= 第 2 行：内容 ================= -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="16" Padding="0,0,0,24">

                <!-- 摘要卡片：先给总量，再给细节。
                     人打开这一页第一个想问的是"我今天用了多久"，不是"哪个应用第一"。 -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="16,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="6">
                        <!--
                          行高写死。
                          【为什么】这一页每 20 秒自动刷新一次，数字会变（"2 小时 58 分"→"3 小时 1 分"）。
                          行高不固定的话，字一换行整块会往下顶一下，页面看着像在抖。
                          写死行高之后，变的只有字，位置不动。
                        -->
                        <Label Text="{Binding TotalText}"
                               FontSize="30"
                               FontAttributes="Bold"
                               LineHeight="1.15" />

                        <Label Text="{Binding NoteText}"
                               Style="{StaticResource Caption}" />

                        <Button Text="{Binding EntertainmentToggleText}"
                                Style="{StaticResource ChipButton}"
                                HorizontalOptions="Start"
                                Margin="0,4,0,0"
                                Command="{Binding ToggleEntertainmentCommand}"
                                IsVisible="{Binding IsEmpty, Converter={StaticResource Not}}" />

                        <Label Text="{Binding EntertainmentText}"
                               Style="{StaticResource Caption}"
                               IsVisible="{Binding IsEntertainmentShown}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 柱状图：日看 24 小时，周/月看每天，年看每月。 -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="16,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="什么时候在用"
                                   Style="{StaticResource CardTitle}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding ChartCaption}"
                                   Style="{StaticResource Caption}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <GraphicsView x:Name="Chart" HeightRequest="140" />
                    </VerticalStackLayout>
                </Border>

                <!--
                  应用排行。
                  【为什么这一块也要进卡片】
                  上一版它是裸在页面上的：上面两块有框、它没框，
                  三段内容看着像两个页面拼起来的。装进同款卡片之后，
                  这一页才是"三块结构一致的内容"。
                -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="16,14"
                        IsVisible="{Binding HasApps}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="12">
                        <Label Text="用在哪"
                               Style="{StaticResource CardTitle}" />

                        <!-- 用 BindableLayout 而不是 CollectionView：这一页整体在 ScrollView 里，
                             再嵌一个会自己滚的列表，滚动手势会打架（滚到列表上就滚不动页面了）。
                             条目最多九行（前八 + 其余），一次全渲染没有任何性能问题。 -->
                        <VerticalStackLayout Spacing="12"
                                             BindableLayout.ItemsSource="{Binding Apps}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:AppUsageRow">
                                    <VerticalStackLayout Spacing="5">
                                        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Name}"
                                                   FontSize="13"
                                                   LineBreakMode="TailTruncation"
                                                   VerticalOptions="Center" />

                                            <Label Grid.Column="1"
                                                   Text="{Binding BadgeText}"
                                                   FontSize="10"
                                                   TextColor="{StaticResource WarnOrange}"
                                                   IsVisible="{Binding HasBadge}"
                                                   VerticalOptions="Center" />

                                            <Label Grid.Column="2"
                                                   Text="{Binding DurationText}"
                                                   Style="{StaticResource Caption}"
                                                   VerticalOptions="Center" />

                                            <!--
                                              「标记」放在这一行上，是因为人想改的时候，
                                              正是看见"B 站 1 小时 20 分"的这一刻。
                                              汇总行（其余 N 个）没有对应的进程，按钮藏起来。
                                            -->
                                            <Button Grid.Column="3"
                                                    Text="标记"
                                                    Style="{StaticResource ChipButton}"
                                                    IsVisible="{Binding CanMark}"
                                                    ToolTipProperties.Text="算娱乐 / 算工作 / 不标记"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TimeViewModel}}, Path=MarkAppCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>

                                        <!-- 条形长度按第一名归一，用来扫"谁占大头"；
                                             按总时长归一的话，所有条都会被压得很短，看不出差别。 -->
                                        <ProgressBar Progress="{Binding Ratio}"
                                                     HeightRequest="6"
                                                     ProgressColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ================= 娱乐超时提醒（M9） =================
                     【为什么这块放在统计下面，而不是做成一个单独的设置页】
                     这一页已经在回答"我的时间去哪了"。紧接着自然的一个问题是
                     "那能不能拦我一下"——两个问题挨着问，人才会顺手去设。
                     藏进二级页面，等于把最需要被打开的那个开关放到了没人去的地方。
                     同时它是统计之后的内容，不抢首屏——这一页第一眼要给的仍然是"你今天用了多久"。 -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="16,14"
                        IsVisible="{Binding HasIntervention}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="娱乐超时提醒"
                                   Style="{StaticResource CardTitle}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsReminderOn}" />
                        </Grid>

                        <Label Text="{Binding ThresholdText}"
                               Style="{StaticResource Caption}" />

                        <!-- 四档固定值，不做输入框：可选的数字键在小屏/中文输入法下很容易打错，
                             而打错一个数字的后果是"提醒永远不来"或者"两分钟弹一次"。 -->
                        <HorizontalStackLayout Spacing="6">
                            <Button Text="15 分钟"
                                    Style="{StaticResource ChipButton}"
                                    Command="{Binding SetThresholdCommand}"
                                    CommandParameter="15">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsThreshold15}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="30 分钟"
                                    Style="{StaticResource ChipButton}"
                                    Command="{Binding SetThresholdCommand}"
                                    CommandParameter="30">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsThreshold30}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="45 分钟"
                                    Style="{StaticResource ChipButton}"
                                    Command="{Binding SetThresholdCommand}"
                                    CommandParameter="45">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsThreshold45}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>

                            <Button Text="60 分钟"
                                    Style="{StaticResource ChipButton}"
                                    Command="{Binding SetThresholdCommand}"
                                    CommandParameter="60">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsThreshold60}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="BorderColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource PrimaryDarkText}}" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </HorizontalStackLayout>

                        <!--
                          引擎自己的心跳。
                          【为什么要把"它现在看到什么"写出来】
                          一个只在关键时刻出声的功能，平时完全静默。没有这行字，
                          用户分不清"还没到 30 分钟"、"它坏了"、"它根本没启动"——
                          这三种情况在界面上长得一模一样：什么都没有。
                        -->
                        <Label Text="{Binding Intervention.StatusText}"
                               Style="{StaticResource Caption}" />

                        <HorizontalStackLayout Spacing="10">
                            <Button Text="发一条测试通知"
                                    Style="{StaticResource ChipButton}"
                                    Command="{Binding SendTestNoticeCommand}" />
                            <Label Text="{Binding Intervention.LastCheckText}"
                                   Style="{StaticResource Caption}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ================= AI 主动开口 =================

                     【为什么要在这里给它一个开关和一个"现在就说一句"】
                     它是唯一一个"没人请求就自己出声"的功能，
                     比任何其他东西都更需要：① 一个能一键关掉的地方；
                     ② 一个立刻能验证它到底说得好不好的按钮。
                     少了前者它会变成骚扰，少了后者只能干等一整天。 -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardStyle}"
                        IsVisible="{Binding HasProactive}"
                        Margin="0,12,0,0"
                        Padding="16,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="AI 主动开口"
                                   Style="{StaticResource CardTitle}"
                                   VerticalOptions="Center" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding IsProactiveOn}" />
                        </Grid>

                        <Label Text="{Binding ProactiveRuleText}"
                               Style="{StaticResource Caption}" />

                        <!-- 心跳：它平时完全静默，没有这行字就分不清"还没到点儿"和"坏了"。 -->
                        <Label Text="{Binding ProactiveStatusText}"
                               Style="{StaticResource Caption}" />

                        <Button Text="现在让它说一句"
                                Style="{StaticResource ChipButton}"
                                HorizontalOptions="Start"
                                Command="{Binding TestProactiveCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- ================= 后台与开机 =================

                     【为什么这一块必须摆出来】
                     "窗口不见了但程序还在跑"这件事如果只有一个地方能改（托盘菜单），
                     人要么不知道它存在，要么知道了也不知道怎么关掉。
                     而"以为关掉了其实还在后台记着"是比任何 bug 都严重的失信。 -->
                <Border Grid.Row="0"
                        Style="{StaticResource CardStyle}"
                        IsVisible="{Binding HasShellControls}"
                        Margin="0,12,0,0"
                        Padding="14,12">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="后台与开机"
                               Style="{StaticResource CardTitle}" />

                        <HorizontalStackLayout Spacing="8">
                            <Button Text="{Binding AutoStartText}"
                                    Style="{StaticResource ChipButton}"
                                    Command="{Binding ToggleAutoStartCommand}" />

                            <Button Text="{Binding CloseToTrayText}"
                                    Style="{StaticResource ChipButton}"
                                    Command="{Binding ToggleCloseToTrayCommand}" />
                        </HorizontalStackLayout>

                        <Label Text="藏起来之后，使用时长照记、提醒照弹。任务栏不再占位置，托盘里能把它叫回来。"
                               Style="{StaticResource Caption}" />

                        <Button Text="现在就藏到托盘"
                                Style="{StaticResource ChipButton}"
                                HorizontalOptions="Start"
                                Command="{Binding HideToTrayCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- 空状态里必须说清楚"为什么没有"。
                     只说"还没有数据"，用户会以为是这一页坏了——
                     而实际原因可能是程序刚开、或者人不在。 -->
                <VerticalStackLayout Spacing="6"
                                     Margin="0,24,0,0"
                                     IsVisible="{Binding IsEmpty}">
                    <Label Text="这段时间还没有记录。"
                           FontSize="13"
                           HorizontalTextAlignment="Center" />
                    <Label Text="程序开着就会自动记，用一会儿再回来看。"
                           Style="{StaticResource Caption}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
