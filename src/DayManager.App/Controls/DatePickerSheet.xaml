<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:DayManager.App.Controls"
             x:Class="DayManager.App.Controls.DatePickerSheet"
             x:Name="Root"
             x:DataType="controls:DatePickerSheet"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">

    <!--
      ============================================================
      选目标日期的那块浮层：日历 + 几个最常用的答案。

      【为什么做成一个独立控件，而不是各页面各写一遍】
      同一块面板要在两处出现：大任务列表页（卡片上的「更多」）和详情页（顶部的「改日期」）。
      第一版只有列表页，逻辑是直接写在那张页面里的；加详情页时如果原样复制，
      以后调一次样式（间距、措辞、多一个快捷按钮）就要记得改两个地方，
      而"忘了其中一个"的表现是两个页面的同一个动作长得不一样——这种事不会报错，
      只会让用户觉得这软件东一块西一块。
      控件做不到 100% 复用（每个页面的命令不一样），但至少版式只有一份。

      【为什么浮在页面上，而不是跳到单独一页】
      改完日期要看的是"现在还剩几天"，那行字就在浮层底下。
      跳走再回来，中间多一次导航和一次"我刚才改的是哪个"。

      【为什么最外层是"遮罩 + 卡片"两个平级元素，而不是卡片套在带手势的 Grid 里】
      手势会沿"子 → 父"这条链往上传递：如果把"点空白取消"的手势挂在最外层 Grid 上，
      点在卡片内部也一样会触发它——点「就这天」的同时面板被关掉，
      能不能改成功全看两者执行顺序，那是碰运气。
      平铺之后，点在卡片上命中的就是卡片，下面的遮罩收不到这次点击。

      【为什么所有绑定都写 Source={x:Reference Root}】
      这个控件的 BindableContext 由使用它的页面决定（页面 VM），
      而面板自己的数据（标题、选中的日期、四个命令）在上层是 BindableProperty。
      不写 Source 的话，绑定会去页面 VM 上找 Title / SelectedDate，找不到。
      写成 x:Reference Root 后，绑定源永远是控件自己，跟页面 VM 长什么样无关。
      ============================================================
    -->

    <Grid>

        <!-- 遮罩本身：铺满整格，点它就是取消。 -->
        <BoxView Color="#66000000">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CancelCommand, Source={x:Reference Root}}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- 声明在后面 = 画在遮罩上面，于是这块区域归它接管。 -->
        <Border Style="{StaticResource CardStyle}"
                Padding="16,14"
                Margin="24"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                WidthRequest="340">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>

            <VerticalStackLayout Spacing="10">
                <!-- 标题写清"正在改哪一个"。同时开着好几个项目时，这句话是唯一能防改错对象的东西。 -->
                <Label Text="{Binding Title, Source={x:Reference Root}}"
                       Style="{StaticResource CardTitle}"
                       LineBreakMode="TailTruncation" />
                <Label Text="打算什么时候做完？"
                       Style="{StaticResource Caption}" />

                <DatePicker Date="{Binding SelectedDate, Source={x:Reference Root}, Mode=TwoWay}"
                            MinimumDate="{Binding MinimumDate, Source={x:Reference Root}}"
                            Format="yyyy年M月d日 dddd"
                            FontSize="15"
                            HorizontalOptions="Fill" />

                <!-- 最常用的几个答案放在第一屏：
                     翻日历找"两周后那天"要点四五次还要数格子，
                     而"两周内做完"是最常见的说法。日历留给"心里有个具体日子"的时候。 -->
                <FlexLayout Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start">
                    <Button Text="3 天后"
                            Style="{StaticResource ChipButton}"
                            Margin="0,0,6,6"
                            Command="{Binding QuickPickCommand, Source={x:Reference Root}}"
                            CommandParameter="3d" />
                    <Button Text="一周后"
                            Style="{StaticResource ChipButton}"
                            Margin="0,0,6,6"
                            Command="{Binding QuickPickCommand, Source={x:Reference Root}}"
                            CommandParameter="1w" />
                    <Button Text="两周后"
                            Style="{StaticResource ChipButton}"
                            Margin="0,0,6,6"
                            Command="{Binding QuickPickCommand, Source={x:Reference Root}}"
                            CommandParameter="2w" />
                    <Button Text="一个月后"
                            Style="{StaticResource ChipButton}"
                            Margin="0,0,6,6"
                            Command="{Binding QuickPickCommand, Source={x:Reference Root}}"
                            CommandParameter="1m" />
                </FlexLayout>

                <HorizontalStackLayout Spacing="8" HorizontalOptions="End">
                    <!-- 「还没定」不是「取消」：前者会真的把日期清掉，后者什么都不做。
                         两个按钮并排放，措辞必须让区别一眼看得见。 -->
                    <Button Text="还没定"
                            Style="{StaticResource ChipButton}"
                            ToolTipProperties.Text="清掉目标日期"
                            Command="{Binding ClearCommand, Source={x:Reference Root}}" />
                    <Button Text="取消"
                            Style="{StaticResource ChipButton}"
                            Command="{Binding CancelCommand, Source={x:Reference Root}}" />
                    <Button Text="就这天"
                            CornerRadius="8"
                            Padding="14,6"
                            FontSize="13"
                            Command="{Binding ConfirmCommand, Source={x:Reference Root}}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>
