<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DayManager.App.ViewModels"
             xmlns:controls="clr-namespace:DayManager.App.Controls"
             x:Class="DayManager.App.ProjectDetailPage"
             x:DataType="vm:ProjectDetailViewModel"
             Shell.NavBarIsVisible="False"
             Title="大任务">

    <!--
      ============================================================
      一个大任务下面的子任务清单。

      【为什么返回按钮是自己做的，还放在项目名旁边】
      系统导航栏自带一个返回箭头，但它是个小图标、颜色很浅，
      用户的原话是"有点不明显"——而且上一版还真的把人困住过一次
      （那时用了 /// 导航，Tab 栏被换掉，箭头也没有）。
      这一页唯一的出口必须一眼就看得见，所以放在标题旁边、用主色描边。
      顺带把系统导航栏关掉：留两个返回入口反而让人犹豫该点哪个，
      而那条横条换成内容能多显示一行。

      【为什么顶部的进度条和列表里的打勾不是一回事】
      进度条是算出来的（自动汇总），打勾是手动的。
      两者不冲突：勾完一条，进度条立刻跟着动，
      但没有任何一个按钮能直接把进度条拉满——
      这是"大任务只是容器"这条决定在界面上的样子。

      【为什么这一版变成了一棵树】
      阶段不是另一种"事情"，就是一条 ParentTaskId 指回上一层的普通记录，
      所以「大任务 → 第 1 章 → 做题 / 真题」不用第二张表、第二个类型。
      平铺的记录在 Core/Planning/ProjectTree 里组装成带 Depth 的行，
      这里只把 Depth 变成缩进（RowPadding）。容器行没有打勾按钮、
      不进分母，只显示下级进度和「往里加」；缩进错位是刻意的：
      父级更靠左、子级又有打勾又缩进，层级一眼能看出来。
      ============================================================

      页面分四行：
        第 0 行 Auto  项目名 + 目标日期
        第 1 行 Auto  进度条 + 完成几件
        第 2 行 Auto  加一条 / 加一层阶段（可挂到某一层下）
        第 3 行 *     带缩进的子任务清单
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,*"
          Padding="14"
          RowSpacing="8">

        <!-- 第 0 行：返回按钮和项目名并排。返回放在这里是因为这一页没有别的出口。 -->
        <Grid Grid.Row="0"
              ColumnDefinitions="Auto,*"
              ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="&lt; 返回"
                    Style="{StaticResource BackButton}"
                    Command="{Binding BackCommand}"
                    VerticalOptions="Center" />

            <VerticalStackLayout Grid.Column="1"
                                 Spacing="2"
                                 VerticalOptions="Center">
                <Label Text="{Binding Name}"
                       FontSize="20"
                       FontAttributes="Bold"
                       LineBreakMode="WordWrap" />

                <!-- 目标日期这一行带上「改日期」。
                     入口放在这句话旁边，是因为人想改期限的时刻，
                     通常就是看见"还剩 2 天"的这一刻——让他返回列表页去找那张卡片，多数人就先不改了。 -->
                <HorizontalStackLayout Spacing="8">
                    <Label Text="{Binding TargetText}"
                           Style="{StaticResource Caption}"
                           VerticalOptions="Center" />
                    <Button Text="改日期"
                            Style="{StaticResource ChipButton}"
                            Command="{Binding OpenDatePanelCommand}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Grid>

        <VerticalStackLayout Grid.Row="1" Spacing="4">
            <ProgressBar Progress="{Binding ProgressRatio}"
                         HeightRequest="6"
                         ProgressColor="{StaticResource DoneGreen}" />
            <Label Text="{Binding ProgressText}"
                   Style="{StaticResource Caption}" />
        </VerticalStackLayout>

        <!-- ================= 第 2 行：加一条 / 加一层阶段 =================

             【为什么这一行必须有】
             这一页原先只能看、只能删，加子任务只能去对话页让 AI 建。
             于是"自己新建大任务"成了半截功能：壳能建，里面装不进东西——
             用户原话就是"我建的大任务没法往里加任务"。
             而且 AI 不可用的时候（离线、后端没起），这条唯一的路也断了。

             【为什么加了一个"形态"按钮，却没做成第二套界面】
             阶段和任务是同一个输入框、同一个「加入」，只差一个开关。
             左边那个小按钮在「加任务 / 加阶段」之间切，
             不弹菜单、不新开页面——用户说过 UI 有点繁杂，能少一个控件就少一个。
             切成「加阶段」时建出来的还是一条 Item，只是 CompletionMode 不同。

             【往里加】
             点某个容器行的「往里加」，ParentStageId 就指到那一层，
             接下来加的东西都挂在它下面，提示语也跟着变。
             上面那条「回顶层」只在挂靠时出现，一键清掉，不用记住刚才点了哪。 -->
        <VerticalStackLayout Grid.Row="2" Spacing="4">

            <HorizontalStackLayout Spacing="6"
                                   IsVisible="{Binding HasParentStage}">
                <Label Text="{Binding ParentStageLabel}"
                       Style="{StaticResource Caption}"
                       VerticalOptions="Center" />
                <Button Text="回顶层"
                        Style="{StaticResource ChipButton}"
                        Command="{Binding ClearParentStageCommand}"
                        VerticalOptions="Center" />
            </HorizontalStackLayout>

            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="6">
                <Button Grid.Column="0"
                        Text="{Binding AddKindText}"
                        Style="{StaticResource ChipButton}"
                        Command="{Binding ToggleAddKindCommand}"
                        VerticalOptions="Center" />
                <Entry Grid.Column="1"
                       Text="{Binding NewTitle}"
                       Placeholder="{Binding AddPlaceholder}"
                       ReturnType="Done"
                       ReturnCommand="{Binding AddSubtaskCommand}"
                       FontSize="14" />
                <Button Grid.Column="2"
                        Text="加入"
                        Command="{Binding AddSubtaskCommand}"
                        WidthRequest="60"
                        HeightRequest="40"
                        CornerRadius="8"
                        Padding="0"
                        FontSize="13" />
            </Grid>
        </VerticalStackLayout>

        <CollectionView Grid.Row="3"
                        ItemsSource="{Binding Items}"
                        SelectionMode="None">

            <!-- 空的时候直接告诉他下面那个输入框是干嘛的，
                 而不是让他去找"到底在哪加"。 -->
            <CollectionView.EmptyView>
                <Label Text="这个项目还没有任务。&#10;用上面那个输入框加第一条，&#10;或者在对话里让 AI 帮你拆。"
                       Style="{StaticResource Caption}"
                       FontSize="13"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       Margin="0,40,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <!--
                  和日程页那一行的结构刻意保持一致：
                  左边打勾、中间标题+徽章+说明、右边更多。
                  同一个软件里同一种东西应该长一个样。

                  这一版多出来的只有三处，全都绑在 ItemViewModel 的树行属性上：
                    整行缩进 RowPadding（Depth 由 Core 的纯函数算好）；
                    容器行隐藏打勾 / 启动，改显示下级进度和「往里加」；
                    叶子行保持原样。复用同一个模板，不为详情页另造一套。
                -->
                <DataTemplate x:DataType="vm:ItemViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                          ColumnSpacing="8"
                          Padding="{Binding RowPadding}">

                        <!-- 打勾：只有叶子行有。容器没有完成按钮，进度由下级汇总，
                             勾它等于把"做到一半"伪装成"做完了"。 -->
                        <Button Grid.Column="0"
                                Text="&#10003;"
                                Style="{StaticResource RoundIconButton}"
                                TextColor="{Binding CheckColor}"
                                IsVisible="{Binding IsLeaf}"
                                VerticalOptions="Center"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProjectDetailViewModel}}, Path=ToggleCompleteCommand}"
                                CommandParameter="{Binding .}" />

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2"
                                             VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="6">
                                <Label Text="{Binding Title}"
                                       TextColor="{Binding TitleColor}"
                                       TextDecorations="{Binding TitleDecorations}"
                                       FontSize="15"
                                       LineBreakMode="TailTruncation"
                                       VerticalOptions="Center" />

                                <Border Padding="5,1"
                                        Stroke="{Binding StatusBrush}"
                                        StrokeThickness="1"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding HasStatusBadge}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="4" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding StatusText}"
                                           TextColor="{Binding StatusColor}"
                                           FontSize="10" />
                                </Border>
                            </HorizontalStackLayout>

                            <Label Text="{Binding Subtitle}"
                                   Style="{StaticResource Caption}" />

                            <!-- 容器行的「1 / 3 件完成」。叶子行留空（HasStageProgress 为 false）。 -->
                            <Label Text="{Binding StageProgressText}"
                                   Style="{StaticResource Caption}"
                                   IsVisible="{Binding HasStageProgress}" />
                        </VerticalStackLayout>

                        <!-- 启动：ShowTimerButton 已经把「容器不给」算进去了，
                             比 CanStartPause 少一层界面自己要记的判据。 -->
                        <Button Grid.Column="2"
                                Text="{Binding StartButtonText}"
                                Style="{StaticResource ChipButton}"
                                WidthRequest="52"
                                IsVisible="{Binding ShowTimerButton}"
                                VerticalOptions="Center"
                                ToolTipProperties.Text="点上就正式开始计时，再点一下暂停"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProjectDetailViewModel}}, Path=ToggleStartPauseCommand}"
                                CommandParameter="{Binding .}" />

                        <!-- 往里加：只有容器行有。点它把这一层设成当前挂靠点，
                             下一个输入框里加的东西就挂在它下面。 -->
                        <Button Grid.Column="3"
                                Text="往里加"
                                Style="{StaticResource ChipButton}"
                                WidthRequest="52"
                                IsVisible="{Binding IsContainer}"
                                VerticalOptions="Center"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProjectDetailViewModel}}, Path=PickParentStageCommand}"
                                CommandParameter="{Binding .}" />

                        <Button Grid.Column="4"
                                Text="更多"
                                Style="{StaticResource ChipButton}"
                                WidthRequest="46"
                                VerticalOptions="Center"
                                ToolTipProperties.Text="重命名 / 删除 / 改状态"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProjectDetailViewModel}}, Path=ShowActionsCommand}"
                                CommandParameter="{Binding .}" />
                    </Grid>
                </DataTemplate>
                        </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- ============ 改目标日期的浮层 ============
             和列表页用的是同一个控件（版式与设计理由都在 Controls/DatePickerSheet.xaml）。
             声明在最后 = 画在所有内容上面，铺满四行。 -->
        <controls:DatePickerSheet Grid.RowSpan="4"
                                  IsVisible="{Binding IsDatePanelVisible}"
                                  Title="{Binding Name}"
                                  SelectedDate="{Binding EditingDate, Mode=TwoWay}"
                                  MinimumDate="{Binding EarliestDate}"
                                  ConfirmCommand="{Binding ConfirmDateCommand}"
                                  ClearCommand="{Binding ClearDateCommand}"
                                  CancelCommand="{Binding CancelDateCommand}"
                                  QuickPickCommand="{Binding PickQuickDateCommand}" />
    </Grid>
</ContentPage>
