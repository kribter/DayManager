<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>DayManager.DbSetDemo</RootNamespace>
  </PropertyGroup>

  <!-- 这是一个教学用的小程序，刻意没有加入 DayManager.slnx（和 SmokeTest 一样）。
       它的作用是把 EF Core 生成的 SQL 打印出来，让人直观看到
       "DbSet 不是容器、Where 会被翻译成 SQL" 这件事。
       运行方式：dotnet run 后面跟 tools/DbSetDemo 这个项目路径 -->

  <ItemGroup>
    <ProjectReference Include="..\..\src\DayManager.Data\DayManager.Data.csproj" />
  </ItemGroup>

</Project>
