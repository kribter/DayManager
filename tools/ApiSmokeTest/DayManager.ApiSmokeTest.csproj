<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DayManager.ApiSmokeTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DayManager.Core\DayManager.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      直接编译 App 项目里那一份源文件，而不是在这里复制一份。
      复制一份就等于有了两份会各自演化的代码，测试通过也不能说明真实代码没问题。
    -->
    <Compile Include="..\..\src\DayManager.App\Services\ApiClient.cs" />
    <Compile Include="..\..\src\DayManager.App\Services\TaskDecomposer.cs" />
    <!--
      SeedFileReader 同样编译真身。它不引用任何 MAUI 类型，所以在控制台里能直接编。
      这一点是刻意的：token 读不到 → 请求必然 401，而这事曾经因为
      "ServerSettings 用了替身、测试看不见" 而一路溜到了用户面前。
    -->
    <Compile Include="..\..\src\DayManager.App\Services\SeedFileReader.cs" />
    <Compile Include="..\..\src\DayManager.App\Services\BackendLauncher.cs" />
  </ItemGroup>

</Project>
