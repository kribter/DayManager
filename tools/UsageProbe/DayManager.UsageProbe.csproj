<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DayManager.UsageProbe</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DayManager.Data\DayManager.Data.csproj" />
  </ItemGroup>

  <!--
    【为什么直接链接采集器的源文件，而不是引用 App 项目】
    App 是个 WinUI 程序，引用它会把整套 MAUI 启动器一起拖进来，
    而这里只需要那一个类。采集器本身除了 user32.dll 之外不依赖 MAUI，
    链接进来就能跑——这样 P/Invoke 那段可以在没有界面的情况下被真实验证。

    【这个工具是干什么的】
    运行 -> 采样若干秒 -> 把刚落库的会话打出来。
    验证三件事：取得到前台窗口、空闲判断没把正常操作误判成离开、
    时长是按采样间隔累加的（不是墙上钟的差值）。
  -->
  <ItemGroup>
    <Compile Include="..\..\src\DayManager.App\Platforms\Windows\WindowsUsageTracker.cs"
             Link="WindowsUsageTracker.cs" />
    <Compile Include="..\..\src\DayManager.App\Platforms\Windows\SystemAudioMeter.cs"
             Link="SystemAudioMeter.cs" />
  </ItemGroup>

</Project>
